{
  "manifest_version": 3,
  "name": "Bolt Chrome Extension",
  "version": "0.0.103",
  "description": "Connect Bolt to your existing Chrome tabs without launching a separate browser.",
  "permissions": [
    "debugger",
    "scripting",
    "contextMenus",
    "tabs",
    "windows"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Click to connect Bolt",
    "default_icon": {
      "16": "icons/icon-gray-16.png",
      "32": "icons/icon-gray-32.png",
      "48": "icons/icon-gray-48.png",
      "128": "icons/icon-gray-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-gray-16.png",
    "32": "icons/icon-gray-32.png",
    "48": "icons/icon-gray-48.png",
    "128": "icons/icon-gray-128.png"
  }
}
