{
  "manifest_version": 3,
  "name": "Bolt Browser Connector",
  "version": "1.0.0",
  "description": "Lets the Bolt desktop app work in Chrome tabs you choose: Bolt agents read and act on pages you connect, in a labelled tab group.",
  "permissions": [
    "debugger",
    "scripting",
    "contextMenus",
    "tabs",
    "tabGroups"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Connect this tab to Bolt",
    "default_icon": {
      "16": "icons/icon-gray-16.png",
      "32": "icons/icon-gray-32.png",
      "48": "icons/icon-gray-48.png",
      "128": "icons/icon-gray-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-gray-16.png",
    "32": "icons/icon-gray-32.png",
    "48": "icons/icon-gray-48.png",
    "128": "icons/icon-gray-128.png"
  }
}
